# Ambiente: development | testing | production
FLASK_ENV=development

# Chave usada para assinar sessões/cookies (OBRIGATÓRIO trocar em produção)
SECRET_KEY=troque-esta-chave

# Banco de dados. Local: SQLite (padrão). Produção: PostgreSQL do Supabase.
# Local:
DATABASE_URL=sqlite:///app.db
# Supabase (Project Settings > Database > Connection string, modo "Session pooler"):
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@<host>:5432/postgres?sslmode=require

# Origens permitidas para o frontend (separadas por vírgula).
# Em produção, use a URL do site na Vercel, ex.: https://aguia.vercel.app
CORS_ORIGINS=http://localhost:5173

# Porta do servidor de desenvolvimento
PORT=5000
