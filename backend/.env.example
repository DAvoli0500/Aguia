# Ambiente: development | testing | production
FLASK_ENV=development

# Chave usada para assinar sessões/cookies (troque em produção)
SECRET_KEY=troque-esta-chave

# Banco de dados (SQLite por padrão; use postgresql://... se preferir)
DATABASE_URL=sqlite:///app.db

# Origens permitidas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Porta do servidor de desenvolvimento
PORT=5000
